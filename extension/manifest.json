{
  "manifest_version": 3,
  "name": "True Cost",
  "version": "0.1.0",
  "description": "Send the apartment listing you're looking at to True Cost and see every hidden fee.",
  "action": { "default_title": "Find the true cost of this listing" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.vercel.app/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
